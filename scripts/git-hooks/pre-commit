#!/usr/bin/env bash
# pre-commit hook для project-infra-template-compose.
# Валидирует на change:
#   - .claude/plans/           → формат планов и бэклога (validate-plan.sh);
#   - docs/project/**.md       → продуктовый слой (validate-project-doc.sh).
# Чтобы битый артефакт (нет обязательной секции, dangling-dep, кривой frontmatter)
# не доезжал до push. Установка — `make setup` (симлинк в .git/hooks/).
#
# Формат сообщения коммита (Conventional Commits) проверяет отдельный commit-msg hook.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

CHANGED_PLANS=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^\.claude/plans/' || true)
if [ -n "$CHANGED_PLANS" ]; then
  echo "pre-commit: validating .claude/plans/…"
  if [ -x scripts/tools/validate-plan.sh ]; then
    bash scripts/tools/validate-plan.sh
  else
    echo "WARN: scripts/tools/validate-plan.sh не исполняемый — пропускаю" >&2
  fi
fi

CHANGED_PROJECT=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/project/.*\.md$' || true)
if [ -n "$CHANGED_PROJECT" ]; then
  echo "pre-commit: validating docs/project/…"
  if [ -x scripts/tools/validate-project-doc.sh ]; then
    bash scripts/tools/validate-project-doc.sh docs/project
  else
    echo "WARN: scripts/tools/validate-project-doc.sh не исполняемый — пропускаю" >&2
  fi
fi
