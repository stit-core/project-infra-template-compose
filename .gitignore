.env
.env.*
!.env.example
!.env.local.example

# Safety-net: страхует от попадания в commit локального creds-файла такого
# имени (секретные блоки для .env заполняются руками по контракту .env.example).
.onboard-creds

# Rendered configs (generated by render-configs.sh from .tpl).
configs/traefik/dynamic/middlewares.yml
configs/traefik/dynamic/staging.htpasswd
configs/traefik/traefik.yml

# ansible
ansible/*.retry
ansible/inventory.ini

# local
*.local
.claude/settings.local.json
.DS_Store
*.swp
*~

# TLS-артефакты и сводки кредов — в репо не хранятся
*.pem
*.key
*.crt
credentials.md
