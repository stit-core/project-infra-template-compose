.env
.env.*
!.env.example
!.env.local.example

# Safety-net: секрет-блоки для .env выдаёт skill `/request-secret` (stdout,
# ничего не пишет на диск). Этот ignore страхует от попадания в commit любого
# локального creds-файла такого имени.
.onboard-creds

# Rendered configs (generated by render-configs.sh from .tpl).
configs/traefik/dynamic/middlewares.yml
configs/traefik/traefik.yml

# ansible
ansible/*.retry
ansible/inventory.ini

# local
*.local
.claude/settings.local.json
.DS_Store
*.swp
*~

# TLS-артефакты и сводки кредов — в репо не хранятся
*.pem
*.key
*.crt
credentials.md
