# Generated by scripts/render-configs.sh — НЕ редактируй.
# Source: configs/vault-agent/agent.hcl.parts/{head,*,tail}.hcl
# Активные blocks определяются COMPOSE_PROFILES (см. render-configs.sh).

pid_file = "/tmp/vault-agent.pid"

vault {
  # Корп-константа — все проектные VPS логинятся в один Vault.
  address = "https://vault.sftbmb.ru"
}

# AppRole login. role-id / secret-id пишутся trampoline-entrypoint'ом
# (compose/vault-agent.yml) в /secrets-bootstrap.
auto_auth {
  method "approle" {
    config = {
      role_id_file_path                   = "/secrets-bootstrap/role-id"
      secret_id_file_path                 = "/secrets-bootstrap/secret-id"
      remove_secret_id_file_after_reading = false
    }
  }

  sink "file" {
    config = {
      path = "/secrets/.vault-token"
      mode = 0400
    }
  }
}

# ───── Always-on templates ─────
# Эти templates рендерятся независимо от COMPOSE_PROFILES — без них стек
# не поднимется (compose читает meta для image-тегов, traefik читает свой
# static config, otel-agent читает otel.env для bearer-token).

# Non-secret конфиг (BACKEND_TAG etc.) → .runtime/env/compose.env для
# compose --env-file. perms 0444 — compose-парсер ходит под user'ом, под
# которым запущен `docker compose`.
template {
  source      = "/etc/vault-agent/templates/meta.env.tpl"
  destination = "/env/compose.env"
  perms       = 0444
}

# Traefik static config — ACME email/caServer из meta KV-объекта.
# perms 0444 — traefik в контейнере под не-root.
template {
  source      = "/etc/vault-agent/templates/traefik.yml.tpl"
  destination = "/configs/traefik.yml"
  perms       = 0444
}

# OTEL bearer-token + tenant — для otel-agent (always-on) и backend
# (когда profile=backend) через тот же файл.
template {
  source      = "/etc/vault-agent/templates/otel.env.tpl"
  destination = "/secrets/otel.env"
  perms       = 0400
}
