# .env проектного VPS. Заполняется через scripts/new-env.sh + руками по мере
# активации профилей.
#
# ЕДИНСТВЕННЫЙ источник конфига и секретов стека: файл живёт только на VPS
# (chmod 600, gitignored), оператор заполняет и ротирует руками. После смены
# значения — `make deploy` (compose пересоздаёт сервисы с новым env сам).
# Image-теги — тоже здесь (<SVC>_TAG, бамп строго `make bump SVC= TAG=`).
# Секреты профилей заполняются руками по секциям ниже (как сгенерировать —
# в комментарии рядом с каждой переменной).
#
# Форма строки — KEY=значение с начала строки, без пробелов у «=»; значение с
# пробелом, $, кавычкой или знаком шелла — в одинарных кавычках; после значения
# — ничего: комментарий пишется отдельной строкой. Файл читают и шелл скриптов,
# и compose: строку другой формы `make deploy`, `make doctor` и ops-вербы
# отвергают раньше, чем её прочтут (scripts/preflight-env.sh).

PROJECT_NAME=
ENV=
# Домен среды — запись хоста: строчные латинские буквы, цифры и дефис, IDN — в
# punycode (xn--…), без схемы, порта, пути и точки на конце. Сайт получает его
# как SITE_URL и с другой записью не стартует: при профиле site её отвергает
# `make deploy`.
DOMAIN=

# ───── ACME (traefik static config, рендерится render-configs.sh) ─────
# email для регистрации в Let's Encrypt (получает expiry-нотификации).
ACME_EMAIL=
# CA-сервер: prod LE — дефолт; для тестов staging:
# https://acme-staging-v02.api.letsencrypt.org/directory
# (после переключения — удалить volume traefik-acme, acme.json привязан к CA).
ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Profile opt-in. Раскомментировать и заполнить секреты соответствующей
# секции ниже. Несколько профилей — через запятую (postgres, storage,
# backend, site). См. .claude/rules/multi-env.md.
# COMPOSE_PROFILES=backend

# Image-тег backend (git.stit.tech/<p>/backend:<tag>). Конвенция: тег любого
# сервиса живёт ТОЛЬКО здесь как <SVC>_TAG (UPPER_SNAKE).
# Бамп — `make bump SVC=backend TAG=<tag>` (правит .env + force-recreate).
# Раскомментировать вместе с COMPOSE_PROFILES=backend.
# BACKEND_TAG=

# Заполняется автоматически на первом `make deploy` (cscli bouncers add traefik).
CROWDSEC_BOUNCER_API_KEY=

# ───── Registry ─────
# Хост container registry, из которого пуллятся образы сервисов (дефолт в
# compose — git.stit.tech). Другой registry — раскомментируйте и задайте хост.
# REGISTRY_HOST=git.stit.tech

# ───── profile postgres ─────
# Пароль: openssl rand -hex 32
# POSTGRES_USER=app
# POSTGRES_PASSWORD=
# POSTGRES_DB=app

# ───── profile backend (+ требует секцию postgres) ─────
# OIDC-клиент выдаёт ваш IDP (client_id + client_secret).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Ключ подписи JWT: openssl rand -hex 64
# JWT_SECRET=

# ───── profile site (индексируемый сайт на корне DOMAIN, www → корень) ─────
# Image-тег site (<registry>/<p>/site:<tag>): первый тег и каждый следующий
# ставит `make bump SVC=site TAG=<tag>` при профиле site в COMPOSE_PROFILES;
# верб ждёт healthy. Адрес сайта контейнер получает из DOMAIN.
# SITE_TAG=
# Индексация среды: index — прод, noindex — любая не-прод среда (robots.txt
# сервиса закрывает сайт, X-Robots-Tag — на каждом ответе). `make new-env`
# ставит ключ по ENV: prod — index, иначе noindex. Имя сверяется буквально:
# прод-среде с другим именем (production, PROD) index ставит оператор.
ROBOTS_POLICY=index
# Уровень JSON-лога сайта: debug | info | warn | error.
# SITE_LOG_LEVEL=info
# DSN проекта в Sentry (Settings → Client Keys); пусто — отправка выключена.
# SITE_SENTRY_DSN=
# Ключ IndexNow, 8–128 символов a-zA-Z0-9-: openssl rand -hex 16. Сайт
# подтверждает его файлом /<ключ>.txt.
# SITE_INDEXNOW_KEY=
# Канал доставки заявки с формы: smtp | backend.
# SITE_FORM_DELIVERY=smtp
# Канал smtp: строка подключения почтового провайдера (smtps://user:pass@host)
# и адреса письма с заявкой — кому и от кого.
# SITE_SMTP_URL=
# SITE_FORM_TO=
# SITE_FORM_FROM=
# Канал backend: адрес внутреннего приёмника заявки (http://<сервис>:<порт>/<путь>).
# SITE_FORM_BACKEND_URL=
#
# Не-прод среду закрывают два ключа: ROBOTS_POLICY=noindex выше и замок здесь.
# Замок — логин (латинские буквы, цифры и ._@-) и bcrypt-хеш пароля basicAuth,
# одна строка 'user:hash' в одинарных кавычках (без них `$` хеша развернёт шелл
# рендера):
#   htpasswd -nbB <user> '<пароль>'   (пакет apache2-utils; без него —
#   docker run --rm httpd:2.4-alpine htpasswd -nbB <user> '<пароль>')
# Задан — роутеры сайта закрыты цепочкой staging@file: без пароля 401, на
# каждом ответе X-Robots-Tag. Пуст — замка нет (прод). Включение, смена пароля
# и снятие — `make deploy`; значение другой формы — и хеш не bcrypt или не
# целиком — он отвергает до рендера. Замок включают раньше, чем выкатывают
# закрытое содержимое: сначала `make deploy` с замком, потом `make bump`.
# STAGING_BASIC_AUTH_USERS=

# ───── profile storage (minio + backup; требует профиль postgres) ─────
# root-креды MinIO: user — слово, пароль — openssl rand -hex 32
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# Service-account backend'а (bucket app-uploads): ключи openssl rand -hex 16 / -hex 32
# APP_S3_ACCESS_KEY=
# APP_S3_SECRET_KEY=
# Service-account restic-rehearsal (bucket backups): ключи openssl rand -hex 16 / -hex 32
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# Bucket-list для minio-init (space-separated; дефолт app-uploads).
# MINIO_BUCKETS=

# Restic-репозиторий. Local-default НЕТ by design: на single-VPS host failure
# уносит и postgres-data, и репо — указывайте external endpoint (managed S3 /
# S3 на другом хосте). Формат: s3:https://<endpoint>/<bucket>
# RESTIC_REPOSITORY=
# Пароль репо: openssl rand -hex 32. ОБЯЗАТЕЛЬНО продублировать offsite —
# без него restore невозможен.
# RESTIC_PASSWORD=
# S3-креды endpoint'а из RESTIC_REPOSITORY (для local-minio rehearsal
# совпадают с BACKUP_S3_*; для external — креды этого endpoint'а).
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=

# ───── MULTI-HOST (split, opt-in; дефолт single-host) ─────
# Дефолт — single-host: весь стек на одном VPS (один VPS = одна среда), HOST_ROLE=all.
# Split — Postgres / MinIO+backup / edge+app по отдельным хостам: на каждом свой
# HOST_ROLE, карта роль→compose-файлы в scripts/deploy.sh (all|edge|db|storage).
# Эндпоинты бэкендов при split — тоже здесь: PG_HOST/PG_PORT (дефолт
# postgres/5432 — co-located), RESTIC_REPOSITORY (S3 на storage-хосте). Шаблон
# даёт только швы; cross-host сеть / репликация / HA — дело потребителя
# (docs/reference/architecture.md § Multi-host split +
# .claude/skills/stack-deep-dive/references/multi-host.md).
HOST_ROLE=all
# PG_HOST=postgres
# PG_PORT=5432
