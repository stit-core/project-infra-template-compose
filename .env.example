# .env проектного VPS. Заполняется через scripts/new-env.sh + руками по мере
# активации профилей.
#
# ЕДИНСТВЕННЫЙ источник конфига и секретов стека: файл живёт только на VPS
# (chmod 600, gitignored), оператор заполняет и ротирует руками. После смены
# значения — `make deploy` (compose пересоздаёт сервисы с новым env сам).
# Image-теги — тоже здесь (<SVC>_TAG, бамп строго `make bump SVC= TAG=`).
# Scaffold блока значений для нового профиля/секрета — skill /request-secret.

PROJECT_NAME=
ENV=
DOMAIN=

# ───── ACME (traefik static config, рендерится render-configs.sh) ─────
# email для регистрации в Let's Encrypt (получает expiry-нотификации).
ACME_EMAIL=
# CA-сервер: prod LE — дефолт; для тестов staging:
# https://acme-staging-v02.api.letsencrypt.org/directory
# (после переключения — удалить volume traefik-acme, acme.json привязан к CA).
ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Profile opt-in. Раскомментировать и заполнить секреты соответствующей
# секции ниже. Несколько профилей — через запятую (postgres, storage,
# backend). См. .claude/rules/multi-env.md.
# COMPOSE_PROFILES=backend

# Image-тег backend (git.stit.tech/<p>/backend:<tag>). Конвенция: тег любого
# сервиса живёт ТОЛЬКО здесь как <SVC>_TAG (UPPER_SNAKE).
# Бамп — `make bump SVC=backend TAG=<tag>` (правит .env + force-recreate).
# Раскомментировать вместе с COMPOSE_PROFILES=backend.
# BACKEND_TAG=

# Заполняется автоматически на первом `make deploy` (cscli bouncers add traefik).
CROWDSEC_BOUNCER_API_KEY=

# ───── Registry (override для self-hosted) ─────
# По умолчанию образы пуллятся из managed-registry stit (git.stit.tech).
# Self-hosted: раскомментируйте и наведите на свой Gitea/registry.
# REGISTRY_HOST=git.stit.tech

# ───── profile postgres ─────
# Пароль: openssl rand -hex 32
# POSTGRES_USER=app
# POSTGRES_PASSWORD=
# POSTGRES_DB=app

# ───── profile backend (+ требует секцию postgres) ─────
# OIDC-клиент выдаёт ваш IDP (client_id + client_secret).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Ключ подписи JWT: openssl rand -hex 64
# JWT_SECRET=

# ───── profile storage (minio + backup; требует профиль postgres) ─────
# root-креды MinIO: user — слово, пароль — openssl rand -hex 32
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# Service-account backend'а (bucket app-uploads): ключи openssl rand -hex 16 / -hex 32
# APP_S3_ACCESS_KEY=
# APP_S3_SECRET_KEY=
# Service-account restic-rehearsal (bucket backups): ключи openssl rand -hex 16 / -hex 32
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# Bucket-list для minio-init (space-separated; дефолт app-uploads).
# MINIO_BUCKETS=

# Restic-репозиторий. Local-default НЕТ by design: на single-VPS host failure
# уносит и postgres-data, и репо — указывайте external endpoint (managed S3 /
# S3 на другом хосте). Формат: s3:https://<endpoint>/<bucket>
# RESTIC_REPOSITORY=
# Пароль репо: openssl rand -hex 32. ОБЯЗАТЕЛЬНО продублировать offsite —
# без него restore невозможен.
# RESTIC_PASSWORD=
# S3-креды endpoint'а из RESTIC_REPOSITORY (для local-minio rehearsal
# совпадают с BACKUP_S3_*; для external — креды этого endpoint'а).
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=

# ───── MULTI-HOST (split, opt-in; дефолт single-host) ─────
# Дефолт — single-host: весь стек на одном VPS (один VPS = одна среда), HOST_ROLE=all.
# Split — Postgres / MinIO+backup / edge+app по отдельным хостам: на каждом свой
# HOST_ROLE, карта роль→compose-файлы в scripts/deploy.sh (all|edge|db|storage).
# Эндпоинты бэкендов при split — тоже здесь: PG_HOST/PG_PORT (дефолт
# postgres/5432 — co-located), RESTIC_REPOSITORY (S3 на storage-хосте). Шаблон
# даёт только швы; cross-host сеть / репликация / HA — дело потребителя
# (docs/reference/architecture.md § Multi-host split +
# .claude/skills/stack-deep-dive/references/multi-host.md).
HOST_ROLE=all
# PG_HOST=postgres
# PG_PORT=5432
