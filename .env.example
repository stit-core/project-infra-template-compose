# Project VPS .env — paste from corp-side onboard-project.sh output.
# All values here are deployment-time facts; secrets (DB password, OIDC
# client_secret, OTEL_TOKEN, etc.) are fetched by vault-agent from Vault
# at runtime and never live in this file.

# ─── Identity ─────────────────────────────────────────────────────────
PROJECT_NAME=                        # tenant name from corp onboarding
DOMAIN=                              # public domain, e.g. acme.com
ACME_EMAIL=                          # contact for Let's Encrypt notifications

# ─── Vault (corp shared) ──────────────────────────────────────────────
VAULT_ADDR=https://vault.stit.tech
VAULT_ROLE_ID=                       # from onboard-project.sh
VAULT_SECRET_ID=                     # from onboard-project.sh

# ─── Telemetry routing ────────────────────────────────────────────────
# OTEL_TOKEN is fetched from Vault by vault-agent into backend.env.
OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TENANT=                         # = $PROJECT_NAME, set explicitly for clarity

# ─── Image versions (CI bumps these on tag push) ──────────────────────
BACKEND_TAG=                         # e.g. v0.1.0; pulled from git.stit.tech/<org>/backend
# FRONTEND_TAG=                      # only if project ships frontend
# WORKER_TAG=                        # only if project ships worker

# ─── CrowdSec ─────────────────────────────────────────────────────────
# Generated on first deploy: docker exec crowdsec cscli bouncers add traefik
CROWDSEC_BOUNCER_API_KEY=

# ─── Backup (restic) ──────────────────────────────────────────────────
# Defaults target corp Minio; override for client-owned S3.
RESTIC_REPOSITORY=                   # e.g. s3:https://s3.stit.tech/backups-<project>
RESTIC_PASSWORD=                     # openssl rand -hex 32; ALSO mirror in Vault
AWS_ACCESS_KEY_ID=                   # from corp Minio onboarding
AWS_SECRET_ACCESS_KEY=

# ─── Gitea runner registration (one-shot, first deploy only) ──────────
# Token from Gitea admin UI: site admin → Actions → Runners → Create new runner.
# After register-runner.sh succeeds, this can be cleared from .env.
GITEA_RUNNER_REG_TOKEN=
