# .env проектного VPS. Заполняется через scripts/new-env.sh.
#
# Минимальный набор: identity (PROJECT_NAME / ENV / DOMAIN) + AppRole-bootstrap
# (VAULT_ROLE_ID / VAULT_SECRET_ID) + image-теги (<SVC>_TAG). Остальное
# (acme email, acme caServer, restic endpoint, OTEL token и runtime-секреты)
# живёт в Vault и рендерится vault-agent'ом — централизованная ротация через
# корп-сторону. Image-теги — ИСКЛЮЧЕНИЕ: бампаются строго через .env
# (`make bump SVC= TAG=`), через Vault не ходят.

PROJECT_NAME=
ENV=
DOMAIN=

VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Backend opt-in. Раскомментировать когда image опубликован в
# git.stit.tech/<p>/backend:<tag>. Несколько профилей — через запятую
# (postgres, storage, backend, ...). См. .claude/rules/multi-env.md.
# COMPOSE_PROFILES=backend

# Image-тег backend (git.stit.tech/<p>/backend:<tag>). Конвенция: тег любого
# сервиса живёт ТОЛЬКО здесь как <SVC>_TAG (UPPER_SNAKE), не в Vault.
# Бамп — `make bump SVC=backend TAG=<tag>` (правит .env + force-recreate).
# Раскомментировать вместе с COMPOSE_PROFILES=backend.
# BACKEND_TAG=

# Заполняется автоматически на первом `make deploy` (cscli bouncers add traefik).
CROWDSEC_BOUNCER_API_KEY=

# ───── Эндпоинты корп control-plane (override для self-hosted) ─────
# По умолчанию наведены на managed-инстанс stit (`*.stit.tech`). Self-hosted:
# раскомментируйте и наведите на свой форк corp-infra-template. Архитектура не
# меняется — меняется только хост. Declared здесь для validate.sh coverage.
# VAULT_ADDR=https://vault.stit.tech
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.stit.tech:443
# REGISTRY_HOST=git.stit.tech

# ───── MULTI-HOST (split, opt-in; дефолт single-host) ─────
# Дефолт — single-host: весь стек на одном VPS (один VPS = одна среда), HOST_ROLE=all.
# Split — Postgres / MinIO+backup / edge+app по отдельным хостам: на каждом свой
# HOST_ROLE, карта роль→compose-файлы в scripts/deploy.sh (all|edge|db|storage).
# Эндпоинты бэкендов НЕ здесь, а в Vault: PG host/port — в kv/.../db (опц. поля
# host/port, дефолт postgres/5432; vault-agent рендерит PG_DSN); restic endpoint
# (MinIO на отдельном хосте) — в kv/.../backup.repository. Шаблон даёт только швы;
# cross-host сеть / репликация / HA — дело потребителя (docs/reference/architecture.md
# § Multi-host split + .claude/skills/stack-deep-dive/references/multi-host.md).
HOST_ROLE=all
