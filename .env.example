# .env проектного VPS. Заполняется через scripts/new-env.sh.
# Runtime-секреты (DB, OIDC, JWT, S3, RESTIC, OTEL_TOKEN) сюда не идут —
# vault-agent рендерит их в .runtime/secrets/*.env по шаблонам
# configs/vault-agent/templates/*.tpl. См. agent.hcl.tpl для деталей.

PROJECT_NAME=
DOMAIN=
ACME_EMAIL=

# Опционально: LE staging endpoint для обкатки шаблона (rate-limits ~100×
# выше, untrusted certs). После переключения prod↔staging — удалить
# volume traefik-acme: `docker compose ... down -v traefik` + redeploy.
# По дефолту — production LE.
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

VAULT_ADDR=https://vault.stit.tech
VAULT_ROLE_ID=
VAULT_SECRET_ID=

OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TENANT=

BACKEND_TAG=

# Backend opt-in. Раскомментировать когда image опубликован в
# git.stit.tech/<p>/backend:<BACKEND_TAG>. Несколько профилей — через запятую
# (frontend, worker и т.д.). Без этой строки backend остаётся в profile и не стартует.
# COMPOSE_PROFILES=backend

# Restic backup endpoint. ОБЯЗАТЕЛЬНО — local-default убран намеренно: на
# single-VPS host failure уносит и postgres-data, и restic-репо вместе.
# scripts/deploy.sh fail'ит на пустом значении. Примеры:
#   s3:https://s3.example.com/<p>-backups   ← external managed S3 (recommended)
#   s3:http://<ip>:9000/<p>-backups         ← bare-IP S3 на другом хосте
#   s3:http://minio:9000/backups            ← local minio (ТОЛЬКО для обкатки)
RESTIC_REPOSITORY=

# Заполняется автоматически на первом `make deploy` (cscli bouncers add traefik).
CROWDSEC_BOUNCER_API_KEY=
