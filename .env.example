# .env проектного VPS. Заполняется один раз на bootstrap'е (через
# scripts/new-env.sh — он промптит и собирает блок).
#
# Что здесь лежит:
#   - Identity проекта (PROJECT_NAME, DOMAIN) и контакты (ACME_EMAIL).
#   - Bootstrap-creds к корп-Vault (AppRole role-id/secret-id из вывода
#     корп-onboard-project.sh) — vault-agent логинится по ним и дальше
#     тянет настоящие секреты из kv/projects/$PROJECT_NAME/*.
#   - Routing для telemetry (адрес OTel-ingest корпа, OTEL_TENANT).
#   - Image tags сервисов (BACKEND_TAG и т.п.) — bump'аются CI на tag push.
#   - Operational creds: restic для backup, gitea-runner reg-token,
#     CrowdSec bouncer key.
#
# Чего здесь НЕТ (сознательно):
#   - Runtime-секретов (DB password, OIDC client_secret, JWT signing key,
#     OTEL_TOKEN). Их рендерит vault-agent в .runtime/secrets/*.env по
#     шаблонам в configs/vault-agent/templates/.
#   - Backend-tuning (PG_MAX_CONNS, HTTP_RATE_LIMIT_RPS, OTEL_TRACES_SAMPLER_ARG
#     и т.п.). У всех ENV golibinfra есть code-defaults; переопределяй
#     только в compose/backend.yml `environment:` блоке если дефолт не
#     подходит конкретному проекту.

# ─── Identity ─────────────────────────────────────────────────────────
PROJECT_NAME=                        # tenant из corp onboard-project.sh
DOMAIN=                              # публичный домен, например acme.com
ACME_EMAIL=                          # контакт для Let's Encrypt уведомлений

# ─── Vault (corp shared) ──────────────────────────────────────────────
# AppRole bootstrap-учётка. Реальные секреты vault-agent забирает сам по
# kv/projects/$PROJECT_NAME/* и kv/observability/tenants/$PROJECT_NAME.
VAULT_ADDR=https://vault.stit.tech
VAULT_ROLE_ID=                       # из onboard-project.sh
VAULT_SECRET_ID=                     # из onboard-project.sh

# ─── Telemetry routing ────────────────────────────────────────────────
# OTEL_TOKEN живёт в Vault, vault-agent рендерит его в backend.env.
OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TENANT=                         # = $PROJECT_NAME, дублируем явно

# ─── Image versions (CI bumps на tag push) ────────────────────────────
BACKEND_TAG=                         # например v0.1.0; pull из git.stit.tech/<org>/backend
# FRONTEND_TAG=                      # раскомментировать если проект имеет frontend
# WORKER_TAG=                        # раскомментировать если проект имеет worker

# ─── CrowdSec ─────────────────────────────────────────────────────────
# Получается на первом деплое: docker exec crowdsec cscli bouncers add traefik
CROWDSEC_BOUNCER_API_KEY=

# ─── Backup (restic) ──────────────────────────────────────────────────
# По умолчанию — корп Minio; для client-owned S3 переопредели repo+keys.
RESTIC_REPOSITORY=                   # например s3:https://s3.stit.tech/backups-<project>
RESTIC_PASSWORD=                     # openssl rand -hex 32; продублировать в Vault
AWS_ACCESS_KEY_ID=                   # из corp Minio onboarding
AWS_SECRET_ACCESS_KEY=

# ─── Gitea runner registration (one-shot, только первый деплой) ───────
# Token из Gitea admin UI: Site Administration → Actions → Runners →
# Create new runner. После регистрации поле можно очистить.
GITEA_RUNNER_REG_TOKEN=
