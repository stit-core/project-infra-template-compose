# .env проектного VPS. Заполняется через scripts/new-env.sh.
# Runtime-секреты (DB, OIDC, JWT, S3, RESTIC, OTEL_TOKEN) сюда не идут —
# vault-agent рендерит их в .runtime/secrets/*.env по шаблонам
# configs/vault-agent/templates/*.tpl. См. agent.hcl.tpl для деталей.

PROJECT_NAME=
DOMAIN=
ACME_EMAIL=

# Опционально: LE staging endpoint для обкатки шаблона (rate-limits ~100×
# выше, untrusted certs). После переключения prod↔staging — удалить
# volume traefik-acme: `docker compose ... down -v traefik` + redeploy.
# По дефолту — production LE.
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

VAULT_ADDR=https://vault.stit.tech
VAULT_ROLE_ID=
VAULT_SECRET_ID=

OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TENANT=

BACKEND_TAG=

# Restic backup endpoint. По дефолту — внутренний minio через docker network,
# без traefik/DNS/TLS — работает сразу на обкатке. Менять на:
#   s3:http://<IP>:9000/backups          ← внешний bare-IP S3
#   s3:https://s3.${DOMAIN}/backups      ← prod через traefik, нужен DNS+cert
RESTIC_REPOSITORY=s3:http://minio:9000/backups

# Заполняется после `docker exec crowdsec cscli bouncers add traefik`.
CROWDSEC_BOUNCER_API_KEY=

# One-shot токен из Gitea admin UI; после регистрации можно очистить.
GITEA_RUNNER_REG_TOKEN=
