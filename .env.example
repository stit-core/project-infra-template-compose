# .env проектного VPS. Заполняется через scripts/new-env.sh.
# Runtime-секреты (DB, OIDC, JWT, S3, RESTIC, OTEL_TOKEN) сюда не идут —
# vault-agent рендерит их в .runtime/secrets/*.env по шаблонам
# configs/vault-agent/templates/*.tpl. См. agent.hcl.tpl для деталей.

PROJECT_NAME=
DOMAIN=
ACME_EMAIL=

VAULT_ADDR=https://vault.stit.tech
VAULT_ROLE_ID=
VAULT_SECRET_ID=

OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TENANT=

BACKEND_TAG=

# Заполняется после `docker exec crowdsec cscli bouncers add traefik`.
CROWDSEC_BOUNCER_API_KEY=

# One-shot токен из Gitea admin UI; после регистрации можно очистить.
GITEA_RUNNER_REG_TOKEN=
