{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker volume ls*)",
      "Bash(docker network ls*)",
      "Bash(docker exec *)",
      "Bash(yamllint *)",
      "Bash(envsubst *)",
      "Bash(scripts/agent-tools/*)",
      "Bash(scripts/hooks-install.sh)",
      "Bash(bash scripts/agent-tools/*)",
      "Bash(bash scripts/hooks-install.sh)",
      "Bash(ansible-playbook *)",
      "Bash(ansible *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push origin*)",
      "Bash(git pull*)",
      "Bash(openssl *)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(.runtime/**)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(.runtime/**)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(.runtime/**)",
      "Write(//*/.claude/projects/*/memory/**)",
      "Edit(//*/.claude/projects/*/memory/**)",
      "MultiEdit(//*/.claude/projects/*/memory/**)",
      "NotebookEdit(//*/.claude/projects/*/memory/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-bash-destructive.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-edit-image-bump.sh"
          },
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-write-no-memory.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/post-compose-validate.sh"
          }
        ]
      }
    ]
  }
}
