{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "max",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker volume ls*)",
      "Bash(docker network ls*)",
      "Bash(docker exec *)",
      "Bash(yamllint *)",
      "Bash(envsubst *)",
      "Bash(scripts/tools/*)",
      "Bash(bash scripts/tools/*)",
      "Bash(ansible-playbook *)",
      "Bash(ansible *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push origin*)",
      "Bash(git pull*)",
      "Bash(openssl *)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Edit(**/.claude/projects/**/memory/**)"
    ]
  }
}
